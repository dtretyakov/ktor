package = libcurl
headers = curl/curl.h
headerFilter = curl/*

compilerOpts = -DCURL_STATICLIB
linkerOpts   = -lcurl -liconv

libraryPaths.linux =         desktop/interop/linuxArm64/lib/
libraryPaths.osx   =         desktop/interop/macosArm64/lib/

staticLibraries = \
libcurl.a \
libcares.a \
libnghttp3.a \
libngtcp2_crypto_quictls.a \
libngtcp2.a \
libnghttp2.a \
libidn2.a \
libunistring.a \
libssh2.a \
libssl.a \
libcrypto.a \
libz.a \
libpsl.a \
libzstd.a \
libbrotlidec.a \
libbrotlicommon.a \
